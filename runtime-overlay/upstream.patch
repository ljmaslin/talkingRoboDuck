-ui.expose_api('GET', '/api/status', controller.status)
+async def speech_audio(request: Request):
+    length = int(request.headers.get('content-length', '0'))
+    if not 0 < length <= 400000:
+        raise HTTPException(413, 'Audio too large or missing length')
+    # ASR runs outside the async WebUI loop and outside the 50 Hz policy thread.
+    import asyncio
+    try:
+        return await asyncio.to_thread(speech.audio, await request.body())
+    except (ValueError, EOFError) as exc:
+        raise HTTPException(400, str(exc))
+
+ui.expose_api('POST', '/api/speech/audio', speech_audio)
+ui.expose_api('POST', '/api/speech/command', speech.command)
+
+ui.expose_api('GET', '/api/status', speech.actions.snapshot)
